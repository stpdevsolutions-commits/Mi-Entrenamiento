# Configuración del servidor Mi Entrenamiento
PORT=3000
NODE_ENV=development

# Ruta del archivo SQLite (en Docker Compose se monta en /data)
DATABASE_PATH=/data/mi-entrenamiento.db

# Clave secreta para firmar cookies de sesión (cámbiala por una cadena larga y aleatoria en producción)
SESSION_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# Seguridad de registro
# Ponlo en "false" después de crear tu cuenta personal para bloquear nuevos registros
ALLOW_REGISTRATION=true
SINGLE_USER_MODE=true

# Cargar datos de ejemplo iniciales si la base está vacía ("true" o "false")
SEED_DEMO_DATA=true

# Confianza en proxy inverso (Caddy / Nginx) para cookies Secure tras HTTPS
TRUST_PROXY=true

# Integración opcional con Gemini IA (desactivada por defecto)
AI_ENABLED=false
GEMINI_API_KEY=
# No almacenar historial completo de chat de IA por defecto
SAVE_AI_HISTORY=false
